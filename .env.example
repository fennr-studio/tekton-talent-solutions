# Public site URL — used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="https://www.tektontalentglobal.com"

# Optional. If set, every hiring / career enquiry is POSTed here as JSON.
# Works with Zapier, Make, n8n, a Supabase Edge Function, or any HTTPS endpoint.
# When unset, submissions are validated and logged to the server console only.
TEKTON_ENQUIRY_WEBHOOK=""

# Optional. Shared secret sent as `x-tekton-signature` with each webhook POST.
TEKTON_ENQUIRY_SECRET=""
